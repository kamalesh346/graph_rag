# =============================================================================
# Legal GraphRAG — Frontend Environment Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local — they are excluded by .gitignore.
#
# NEXT_PUBLIC_* variables are embedded in browser JavaScript at build time.
# DO NOT put secrets (API keys, OAuth secrets) in NEXT_PUBLIC_* variables.
#
# All other variables are server-side only (Next.js API routes / middleware).
# =============================================================================

# ── Backend API (PUBLIC — safe to expose) ────────────────────────────────────
# The base URL of the FastAPI backend.
# Development:  http://127.0.0.1:8000
# Production:   https://your-render-service.onrender.com
#
# This variable IS exposed to the browser (NEXT_PUBLIC_ prefix).
# It must point to a URL the end-user's browser can reach — NOT an internal URL.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ── NextAuth (SERVER-SIDE — never exposed to browser) ────────────────────────
# These variables are used by next-auth (auth.ts / lib/auth.ts).
# Keep them out of NEXT_PUBLIC_ variables.
#
# NEXTAUTH_URL: the canonical URL of your Next.js deployment.
#   Development: http://localhost:3000
#   Production:  https://your-app.vercel.app
#
# NEXTAUTH_SECRET: a random string used to sign JWTs and session tokens.
#   Generate with:  openssl rand -hex 32

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-hex-32

# ── Google OAuth (SERVER-SIDE — never exposed to browser) ────────────────────
# Obtain these from Google Cloud Console → APIs & Services → Credentials.
# Add your authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google  (development)
#   https://your-app.vercel.app/api/auth/callback/google  (production)

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Database (SERVER-SIDE — only required if Prisma / DB features are active) ─
# Currently auth.ts and prisma.ts are defined but Google OAuth is not yet
# wired into any page route. This variable is included for forward-compatibility.
# Leave blank if Prisma is not used.

DATABASE_URL=postgresql://user:password@host:5432/dbname
