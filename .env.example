# =============================================================================
# Legal GraphRAG — Backend / Root Environment Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is excluded by .gitignore.
#
# Required = server will not function correctly without these.
# Optional = server uses a safe default if these are absent.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

# Set to "production" on Render / any deployed host.
# Affects logging verbosity and future environment-specific guards.
APP_ENV=development                             # optional — default: development

# ── Neo4j Graph Database ──────────────────────────────────────────────────────
# Local development: bolt://localhost:7687
# Cloud (Neo4j Aura): neo4j+s://<instance-id>.databases.neo4j.io

NEO4J_URI=bolt://localhost:7687                 # required
NEO4J_USER=neo4j                                # required
NEO4J_PASSWORD=your-neo4j-password-here        # required

# ── LLM Providers ────────────────────────────────────────────────────────────
# At least one of GEMINI_API_KEY or GROQ_API_KEY must be set.
# Gemini is used as primary; Groq is the automatic fallback.

GEMINI_API_KEY=your-gemini-api-key-here        # required (primary LLM)
GROQ_API_KEY=your-groq-api-key-here            # required (fallback LLM)

# Model overrides — leave blank to use the defaults below:
#   Gemini: gemini-2.0-flash
#   Groq:   openai/gpt-oss-120b
LLM_PRIMARY=gemini                              # optional — default: gemini
LLM_GEMINI_MODEL=gemini-2.0-flash              # optional
LLM_GROQ_MODEL=openai/gpt-oss-120b             # optional

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev origins (localhost:3000, localhost:3002) are always included.
# Production: set this to your Vercel deployment URL.
#   Example: FRONTEND_ORIGINS=https://legal-graphrag.vercel.app

FRONTEND_ORIGINS=http://localhost:3000          # optional — set to prod URL in production

# ── Security ─────────────────────────────────────────────────────────────────
# Protect the /api/trace debug endpoint in production.
# Leave blank in development for unauthenticated access.
# In production: generate with `openssl rand -hex 32`

TRACE_TOKEN=                                    # optional — leave blank for open access in dev

# ── Qdrant Cloud (vector store) ───────────────────────────────────────────────────────────────────
# Collections: legal_statute_chunks  (108 points, 384-dim)
#              legal_judgment_chunks  (285 points, 384-dim)
# Obtain from https://cloud.qdrant.io → your cluster → API Keys.

QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io   # required
QDRANT_API_KEY=your-qdrant-api-key-here                        # required

# ── Embedding API ───────────────────────────────────────────────────────────────────
# Query embeddings use HuggingFace Hosted Inference (no local model on Render).
# Model    : sentence-transformers/all-MiniLM-L6-v2  (384 dims)
# Endpoint : https://router.huggingface.co/hf-inference/models/
#            sentence-transformers/all-MiniLM-L6-v2
#
# REQUIRED for Render deployment.  Without it the server attempts to load the
# model locally (⚠ not suitable for Render — high RAM, slow cold-start).
#
# Setup steps:
#   1. Sign in at https://huggingface.co
#   2. Settings → Access Tokens → New token → Role: Read
#   3. Paste the hf_… token as the value below.
#
# Free tier : ~1 000 req/day (adequate for low-traffic deployments)
# PRO tier  : ~$9/month, higher limits — recommended for production

HF_EMBEDDING_API_KEY=hf_your_token_here                        # required on Render

# ── Notes ───────────────────────────────────────────────────────────────────────────────────────
# The embedding model is fixed at sentence-transformers/all-MiniLM-L6-v2
# (384 dimensions).  Stored Qdrant vectors were generated with this exact model.
# Do NOT change the model without re-embedding and re-indexing all collections.
